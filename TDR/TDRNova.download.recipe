<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the latest TDR Nova dynamic equaliser plugin from Tokyo Dawn Records. The download is a free ZIP containing a macOS PKG installer. No account required.</string>
	<key>Identifier</key>
	<string>com.github.Woodmember-Autopkg-Recipes.download.TDRNova</string>
	<key>Input</key>
	<dict>
		<key>CHECK_URL</key>
		<string>https://www.tokyodawn.net/tdr-nova/</string>
		<key>NAME</key>
		<string>TDR Nova</string>
		<key>RE_PATTERN</key>
		<string>\"(https://www\.tokyodawn\.net/labs/Nova/(?P&lt;version&gt;[\d.]+)/TDR%20Nova%20\(installer\)\.zip)\"</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>re_pattern</key>
				<string>https://www\.tokyodawn\.net/labs/Nova/(?P&lt;version&gt;[\d.]+)/TDR Nova</string>
				<key>url</key>
				<string>%CHECK_URL%</string>
			</dict>
			<key>Processor</key>
			<string>URLTextSearcher</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>filename</key>
				<string>%NAME%_%version%.zip</string>
				<key>url</key>
				<string>https://www.tokyodawn.net/labs/Nova/%version%/TDR%20Nova.zip</string>
			</dict>
			<key>Processor</key>
			<string>URLDownloader</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
	</array>
</dict>
</plist>
