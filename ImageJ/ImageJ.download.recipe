<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the latest ImageJ for macOS Apple Silicon (arm64) from wsr.imagej.net. The download is a ZIP containing the ImageJ.app bundle. Replaces the moofit community recipe whose NIH download page URL changed.</string>
    <key>Identifier</key>
    <string>com.github.Woodmember-Autopkg-Recipes.download.ImageJ</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>ImageJ</string>
        <key>DOWNLOAD_BASE</key>
        <string>https://wsr.imagej.net/distros/osx/</string>
    </dict>
    <key>MinimumVersion</key>
    <string>2.3</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>URLTextSearcher</string>
            <key>Arguments</key>
            <dict>
                <key>url</key>
                <string>%DOWNLOAD_BASE%</string>
                <key>re_pattern</key>
                <string>href="(ij(?P&lt;version&gt;[0-9]+)-osx-arm-java21\.zip)"</string>
            </dict>
        </dict>
        <dict>
            <key>Processor</key>
            <string>URLDownloader</string>
            <key>Arguments</key>
            <dict>
                <key>url</key>
                <string>%DOWNLOAD_BASE%%match%</string>
                <key>filename</key>
                <string>%NAME%-%version%-arm64.zip</string>
            </dict>
        </dict>
        <dict>
            <key>Processor</key>
            <string>EndOfCheckPhase</string>
        </dict>
        <dict>
            <key>Processor</key>
            <string>Unarchiver</string>
            <key>Arguments</key>
            <dict>
                <key>archive_path</key>
                <string>%pathname%</string>
                <key>destination_path</key>
                <string>%RECIPE_CACHE_DIR%/unarchived</string>
                <key>purge_destination</key>
                <true/>
            </dict>
        </dict>
        <dict>
            <key>Processor</key>
            <string>FileFinder</string>
            <key>Arguments</key>
            <dict>
                <key>pattern</key>
                <string>%RECIPE_CACHE_DIR%/unarchived/ImageJ.app</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
