<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the latest version of Skim from SourceForge. Uses the project's file RSS feed rather than best_release.json, which still advertises 1.4.15 from 2015 while current releases are 1.7.x.</string>
	<key>Identifier</key>
	<string>com.github.Woodmember-Autopkg-Recipes.download.Skim</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>Skim</string>
		<key>FEED_URL</key>
		<string>https://sourceforge.net/projects/skim-app/rss?path=/Skim</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>filename</key>
				<string>skim-files.rss</string>
				<key>url</key>
				<string>%FEED_URL%</string>
				<key>curl_opts</key>
				<array>
					<string>--location</string>
				</array>
			</dict>
			<key>Processor</key>
			<string>URLDownloader</string>
		</dict>
		<dict>
			<key>Comment</key>
			<string>The feed is newest-first, so the first dmg entry is the current release.</string>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>file://%pathname%</string>
				<key>re_pattern</key>
				<string>Skim-([0-9]+(?:\.[0-9]+)+)\.dmg</string>
				<key>result_output_var_name</key>
				<string>version</string>
			</dict>
			<key>Processor</key>
			<string>URLTextSearcher</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>filename</key>
				<string>%NAME%-%version%.dmg</string>
				<key>url</key>
				<string>https://downloads.sourceforge.net/project/skim-app/Skim/Skim-%version%/Skim-%version%.dmg</string>
				<key>curl_opts</key>
				<array>
					<string>--location</string>
				</array>
			</dict>
			<key>Processor</key>
			<string>URLDownloader</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>input_path</key>
				<string>%pathname%/Skim.app</string>
				<key>requirement</key>
				<string>identifier "net.sourceforge.skim-app.skim" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */</string>
			</dict>
			<key>Processor</key>
			<string>CodeSignatureVerifier</string>
		</dict>
	</array>
</dict>
</plist>
