<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the latest version of the Adobe AIR runtime installer from HARMAN.

HARMAN serves the runtime from a versioned path (assets/downloads/&lt;version&gt;/AdobeAIR.dmg);
the old unversioned assets/downloads/AdobeAIR.dmg now returns 404. The current version is
read out of the download page's Angular bundle, whose filename is content-hashed and so must
itself be discovered first.</string>
	<key>Identifier</key>
	<string>com.github.Woodmember.download.AdobeAIRInstaller</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>Adobe AIR Installer</string>
		<key>BASE_URL</key>
		<string>https://airsdk.harman.com</string>
	</dict>
	<key>MinimumVersion</key>
	<string>1.0.0</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Comment</key>
			<string>Find the content-hashed main bundle referenced by the download page.</string>
			<key>Processor</key>
			<string>URLTextSearcher</string>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>%BASE_URL%/download</string>
				<key>re_pattern</key>
				<string>(?P&lt;bundle&gt;main\.[a-f0-9]+\.js)</string>
			</dict>
		</dict>
		<dict>
			<key>Comment</key>
			<string>Read the runtime version out of that bundle.</string>
			<key>Processor</key>
			<string>URLTextSearcher</string>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>%BASE_URL%/%bundle%</string>
				<key>re_pattern</key>
				<string>assets/downloads/(?P&lt;air_version&gt;[0-9]+(?:\.[0-9]+)+)/AdobeAIR\.dmg</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>URLDownloader</string>
			<key>Arguments</key>
			<dict>
				<key>url</key>
				<string>%BASE_URL%/assets/downloads/%air_version%/AdobeAIR.dmg</string>
				<key>filename</key>
				<string>%NAME%.dmg</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>CodeSignatureVerifier</string>
			<key>Arguments</key>
			<dict>
				<key>input_path</key>
				<string>%pathname%/Adobe AIR Installer.app</string>
				<key>requirement</key>
				<string>identifier "com.adobe.air.Installer" and anchor apple generic and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = ZUQHAK4PRS</string>
			</dict>
		</dict>
		<dict>
			<key>Processor</key>
			<string>Versioner</string>
			<key>Arguments</key>
			<dict>
				<key>input_plist_path</key>
				<string>%pathname%/Adobe AIR Installer.app/Contents/Info.plist</string>
				<key>plist_version_key</key>
				<string>CFBundleVersion</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
