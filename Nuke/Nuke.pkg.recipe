<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads Foundry Nuke and packages the whole release folder into /Applications.

The disk image contains a "Nuke&lt;version&gt;" folder holding TEN applications — Nuke, NukeX,
NukeStudio, NukeAssist, NukeIndie, Hiero, HieroPlayer and the Non-Commercial variants of Nuke,
NukeX and NukeStudio. Foundry's install model is to place that entire folder in /Applications,
so the folder is copied wholesale rather than packaging a single app.

No community recipe exists for Foundry Nuke; recipes matching the name "Nuke" build FontNuke,
an unrelated font-cache cleaner.</string>
	<key>Identifier</key>
	<string>com.github.Woodmember-Autopkg-Recipes.pkg.Nuke</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>Nuke</string>
		<key>pkginfo</key>
		<dict>
			<key>catalogs</key>
			<array>
				<string>testing</string>
			</array>
			<key>description</key>
			<string>Foundry Nuke is a node-based compositing and finishing application for film and television. The package installs the full Nuke family (Nuke, NukeX, NukeStudio, NukeAssist, NukeIndie, Hiero and HieroPlayer).</string>
			<key>developer</key>
			<string>The Foundry</string>
			<key>display_name</key>
			<string>Nuke</string>
			<key>name</key>
			<string>%NAME%</string>
			<key>unattended_install</key>
			<true/>
		</dict>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>ParentRecipe</key>
	<string>com.github.Woodmember-Autopkg-Recipes.download.Nuke</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>pkgroot</key>
				<string>%RECIPE_CACHE_DIR%/pkgroot</string>
				<key>pkgdirs</key>
				<dict>
					<key>Applications</key>
					<string>0775</string>
				</dict>
			</dict>
			<key>Processor</key>
			<string>PkgRootCreator</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>source_path</key>
				<string>%pathname%/Nuke%NUKE_VERSION%</string>
				<key>destination_path</key>
				<string>%RECIPE_CACHE_DIR%/pkgroot/Applications/Nuke%NUKE_VERSION%</string>
			</dict>
			<key>Processor</key>
			<string>Copier</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>pkg_request</key>
				<dict>
					<key>pkgroot</key>
					<string>%RECIPE_CACHE_DIR%/pkgroot</string>
					<key>pkgdir</key>
					<string>%RECIPE_CACHE_DIR%</string>
					<key>pkgname</key>
					<string>%NAME%-%NUKE_VERSION%</string>
					<key>id</key>
					<string>uk.co.thefoundry.Nuke</string>
					<key>version</key>
					<string>%NUKE_VERSION%</string>
					<key>chown</key>
					<array>
						<dict>
							<key>path</key>
							<string>Applications</string>
							<key>user</key>
							<string>root</string>
							<key>group</key>
							<string>admin</string>
						</dict>
					</array>
				</dict>
			</dict>
			<key>Processor</key>
			<string>PkgCreator</string>
		</dict>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>path_list</key>
				<array>
					<string>%RECIPE_CACHE_DIR%/pkgroot</string>
				</array>
			</dict>
			<key>Processor</key>
			<string>PathDeleter</string>
		</dict>
	</array>
</dict>
</plist>
