<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads Sonic Pi and creates a package. aanklewicz's community recipe runs without error but downloads nothing and produces no package, and the upstream GitHub releases carry no macOS asset, so the vendor site is the only usable source.</string>
	<key>Identifier</key>
	<string>com.github.Woodmember-Autopkg-Recipes.pkg.SonicPi</string>
	<key>Input</key>
	<dict>
		<key>NAME</key>
		<string>SonicPi</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>ParentRecipe</key>
	<string>com.github.Woodmember-Autopkg-Recipes.download.SonicPi</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Comment</key>
			<string>The app bundle is "Sonic Pi.app" (with a space) while %NAME% is SonicPi, so pkg_path is set explicitly to keep the package name consistent.</string>
			<key>Arguments</key>
			<dict>
				<key>app_path</key>
				<string>%pathname%/Sonic Pi.app</string>
				<key>pkg_path</key>
				<string>%RECIPE_CACHE_DIR%/%NAME%-%version%.pkg</string>
			</dict>
			<key>Processor</key>
			<string>AppPkgCreator</string>
		</dict>
	</array>
</dict>
</plist>
