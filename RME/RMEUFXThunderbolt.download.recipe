<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the RME UFX+ Thunderbolt DriverKit driver ZIP (macOS 11+), extracts the PKG, verifies the Apple Developer ID signature, and outputs a versioned PKG. Update VERSION and DOWNLOAD_URL when RME releases a new driver.</string>
	<key>Identifier</key>
	<string>com.github.Woodmember-Autopkg-Recipes.download.RMEUFXThunderbolt</string>
	<key>Input</key>
	<dict>
		<key>DOWNLOAD_URL</key>
		<string>https://rme-audio.de/downloads/driver_mac_tbdk_106.zip</string>
		<key>NAME</key>
		<string>RME UFX Thunderbolt Driver</string>
		<key>VERSION</key>
		<string>1.06.0</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.3</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>filename</key>
				<string>%NAME%.zip</string>
				<key>url</key>
				<string>%DOWNLOAD_URL%</string>
			</dict>
			<key>Processor</key>
			<string>URLDownloader</string>
		</dict>
		<dict>
			<key>Processor</key>
			<string>EndOfCheckPhase</string>
		</dict>
	</array>
</dict>
</plist>
