<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the RME UFX+ Thunderbolt DriverKit driver ZIP (macOS 11+), extracts the PKG, verifies the Apple Developer ID signature, and outputs a versioned PKG. Update VERSION and DOWNLOAD_URL when RME releases a new driver. The VERSION input must match the driver version in DOWNLOAD_URL — update both together when RME releases a new version.</string>
    <key>Identifier</key>
    <string>com.github.Woodmember-Autopkg-Recipes.pkg.RMEUFXThunderbolt</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>RME UFX Thunderbolt Driver</string>
        <key>VERSION</key>
        <string>1.06.0</string>
    </dict>
    <key>MinimumVersion</key>
    <string>2.3</string>
    <key>ParentRecipe</key>
    <string>com.github.Woodmember-Autopkg-Recipes.download.RMEUFXThunderbolt</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>Unarchiver</string>
            <key>Arguments</key>
            <dict>
                <key>archive_path</key>
                <string>%pathname%</string>
                <key>destination_path</key>
                <string>%RECIPE_CACHE_DIR%/unarchived</string>
                <key>purge_destination</key>
                <true/>
            </dict>
        </dict>
        <dict>
            <key>Processor</key>
            <string>CodeSignatureVerifier</string>
            <key>Arguments</key>
            <dict>
                <key>input_path</key>
                <string>%RECIPE_CACHE_DIR%/unarchived/UFX+ Thunderbolt DK 106.pkg</string>
                <key>expected_authority_names</key>
                <array>
                    <string>Developer ID Installer: RME GmbH (67AK2U2X7M)</string>
                    <string>Developer ID Certification Authority</string>
                    <string>Apple Root CA</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>Processor</key>
            <string>PkgCopier</string>
            <key>Arguments</key>
            <dict>
                <key>source_pkg</key>
                <string>%RECIPE_CACHE_DIR%/unarchived/UFX+ Thunderbolt DK 106.pkg</string>
                <key>pkg_path</key>
                <string>%RECIPE_CACHE_DIR%/%NAME%-%VERSION%.pkg</string>
            </dict>
        </dict>
        <dict>
            <key>Processor</key>
            <string>PathDeleter</string>
            <key>Arguments</key>
            <dict>
                <key>path_list</key>
                <array>
                    <string>%RECIPE_CACHE_DIR%/unarchived</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>