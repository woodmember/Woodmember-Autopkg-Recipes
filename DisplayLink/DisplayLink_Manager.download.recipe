<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>Description</key>
		<string>Downloads the latest version of the DisplayLink Manager App.

Synaptics moved the download links from /node/&lt;id&gt;?filetype=exe to
/products/displaylink-manager-graphics-connectivity-&lt;ver&gt;?filetype=exe, and dropped the
"Accept" anchor text on the file link, so both searches were rewritten. The current release
is the first match on the page; the Legacy Releases section follows it.</string>
		<key>Identifier</key>
		<string>com.github.Woodmember-Autopkg-Recipes.download.DisplayLink_Manager</string>
		<key>Input</key>
		<dict>
			<key>NAME</key>
			<string>DisplayLink Manager</string>
			<key>SOFTWARE_TITLE</key>
			<string>DisplayLink_Manager</string>
			<key>BASE_URL</key>
			<string>https://www.synaptics.com</string>
			<key>SEARCH_URL</key>
			<string>products/displaylink-graphics/downloads/macos</string>
			<key>LOGIN_EXTENSION_URL</key>
			<string>https://www.synaptics.com/sites/default/files/exe_files/2021-02/macOS%20App%20LoginExtension-EXE.dmg</string>
		</dict>
		<key>Process</key>
		<array>
			<dict>
				<key>Processor</key>
				<string>URLTextSearcher</string>
				<key>Arguments</key>
				<dict>
					<key>re_pattern</key>
					<string>DisplayLink Manager Graphics Connectivity&lt;/h4&gt;[\s\S]*?Release: (?P&lt;version&gt;[0-9.]+)[\s\S]*?href=\"(?P&lt;match&gt;/products/[^\"]*?\?filetype=exe)\"</string>
					<key>url</key>
					<string>%BASE_URL%/%SEARCH_URL%</string>
				</dict>
			</dict>
			<dict>
				<key>Processor</key>
				<string>URLTextSearcher</string>
				<key>Arguments</key>
				<dict>
					<key>re_pattern</key>
					<string>href=\"(?P&lt;download_url&gt;/sites/default/files/exe_files/[^\"]*\.pkg)\"</string>
					<key>url</key>
					<string>%BASE_URL%%match%</string>
				</dict>
			</dict>
			<dict>
				<key>Processor</key>
				<string>URLDownloader</string>
				<key>Arguments</key>
				<dict>
					<key>filename</key>
					<string>%SOFTWARE_TITLE%.pkg</string>
					<key>url</key>
					<string>%BASE_URL%%download_url%</string>
				</dict>
			</dict>
			<dict>
				<key>Processor</key>
				<string>URLDownloader</string>
				<key>Arguments</key>
				<dict>
					<key>filename</key>
					<string>%SOFTWARE_TITLE%_Extension.dmg</string>
					<key>url</key>
					<string>%LOGIN_EXTENSION_URL%</string>
				</dict>
			</dict>
			<dict>
				<key>Processor</key>
				<string>FileFinder</string>
				<key>Arguments</key>
				<dict>
					<key>pattern</key>
					<string>%RECIPE_CACHE_DIR%/downloads/%SOFTWARE_TITLE%_Extension.dmg/*.pkg</string>
				</dict>
			</dict>
			<dict>
				<key>Processor</key>
				<string>EndOfCheckPhase</string>
			</dict>
			<dict>
				<key>Processor</key>
				<string>CodeSignatureVerifier</string>
				<key>Arguments</key>
				<dict>
					<key>expected_authority_names</key>
					<array>
						<string>Developer ID Installer: DisplayLink Corp (73YQY62QM3)</string>
						<string>Developer ID Certification Authority</string>
						<string>Apple Root CA</string>
					</array>
					<key>input_path</key>
					<string>%RECIPE_CACHE_DIR%/downloads/%SOFTWARE_TITLE%.pkg</string>
				</dict>
			</dict>
			<dict>
				<key>Processor</key>
				<string>CodeSignatureVerifier</string>
				<key>Arguments</key>
				<dict>
					<key>expected_authority_names</key>
					<array>
						<string>Developer ID Installer: DisplayLink Corp (73YQY62QM3)</string>
						<string>Developer ID Certification Authority</string>
						<string>Apple Root CA</string>
					</array>
					<key>input_path</key>
					<string>%RECIPE_CACHE_DIR%/downloads/%SOFTWARE_TITLE%_Extension.dmg/%found_basename%</string>
				</dict>
			</dict>
		</array>
	</dict>
</plist>
