<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the latest development version of VESTA (Visualisation for Electronic and STructural Analysis) DMG from jp-minerals.org. VESTA is free for academic and non-commercial use. The DMG structure is: /Volumes/VESTA/VESTA/VESTA.app — the app is inside a VESTA subdirectory on the volume, not at the root. Verifies the Apple Developer ID signature on VESTA.app before proceeding.</string>
    <key>Identifier</key>
    <string>com.github.Woodmember-Autopkg-Recipes.download.VESTA</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>VESTA</string>
        <key>DOWNLOAD_URL</key>
        <string>https://jp-minerals.org/vesta/archives/testing/VESTA.dmg</string>
    </dict>
    <key>MinimumVersion</key>
    <string>2.3</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>URLDownloader</string>
            <key>Arguments</key>
            <dict>
                <key>url</key>
                <string>%DOWNLOAD_URL%</string>
                <key>filename</key>
                <string>%NAME%.dmg</string>
            </dict>
        </dict>
        <dict>
            <key>Processor</key>
            <string>EndOfCheckPhase</string>
        </dict>
        <dict>
            <key>Comment</key>
            <string>The testing-channel build's CFBundleIdentifier is "org.jp-minerals.vesta", not the bare "VESTA" string the stable-channel release still uses (see the community VESTA.download.recipe, which targets archives/&lt;version&gt;/ and still matches "VESTA"). Match whichever channel you actually point DOWNLOAD_URL at.</string>
            <key>Processor</key>
            <string>CodeSignatureVerifier</string>
            <key>Arguments</key>
            <dict>
                <key>input_path</key>
                <string>%pathname%/VESTA/VESTA.app</string>
                <key>requirement</key>
                <string>anchor apple generic and identifier "org.jp-minerals.vesta" and certificate leaf[subject.OU] = "Y66LM3WNCW"</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>
