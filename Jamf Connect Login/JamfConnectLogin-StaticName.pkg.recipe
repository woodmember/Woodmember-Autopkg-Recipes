<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Copies Jamf Connect's package out of the vendor DMG under a static name, for use in Jamf Prestages where the package name must not change between versions.

The signature is verified by the parent download recipe. The old check pointed at Resources/JamfConnectLaunchAgent.pkg, which Jamf no longer ships.</string>
	<key>Identifier</key>
	<string>com.github.Woodmember.pkg.JamfConnectLogin</string>
	<key>Input</key>
	<dict>
		<key>BUNDLE_ID</key>
		<string>com.jamf.connect.login</string>
		<key>NAME</key>
		<string>JamfConnectLogin</string>
	</dict>
	<key>MinimumVersion</key>
	<string>1.0.0</string>
	<key>ParentRecipe</key>
	<string>com.github.Woodmember-Autopkg-Recipes.download.JamfConnect</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>pkg_path</key>
				<string>%RECIPE_CACHE_DIR%/%NAME%_AutoPKG.pkg</string>
				<key>source_pkg</key>
				<string>%pathname%/JamfConnectLogin.pkg</string>
			</dict>
			<key>Processor</key>
			<string>PkgCopier</string>
		</dict>
	</array>
</dict>
</plist>
